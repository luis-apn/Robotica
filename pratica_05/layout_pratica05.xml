<?xml version='1.0' encoding='UTF-8'?>
<root>
 <tabbed_widget name="Main Window" parent="main_window">
  <Tab tab_name="Trajetoria XY" containers="1">
   <Container>
    <DockSplitter orientation="-" count="1" sizes="1">
     <DockArea name="Real x Bruto x Estimado x Desejada">
      <plot mode="XYPlot" style="Lines" flip_x="false" flip_y="false">
       <range bottom="-2.5" top="2.5" left="-1.5" right="1.5"/>
       <limitY/>
       <curve name="Real (ground truth)" color="#2ca02c"
              curve_x="/ground_truth/pose/pose/position/x"
              curve_y="/ground_truth/pose/pose/position/y"/>
       <curve name="Bruto (GPS + IMU)" color="#d62728"
              curve_x="/odom_sensores/pose/pose/position/x"
              curve_y="/odom_sensores/pose/pose/position/y"/>
       <curve name="Estimado (Kalman)" color="#1f77b4"
              curve_x="/odometry/filtered/pose/pose/position/x"
              curve_y="/odometry/filtered/pose/pose/position/y"/>
       <curve name="Desejada" color="#000000"
              curve_x="/trajetoria_desejada/pose/position/x"
              curve_y="/trajetoria_desejada/pose/position/y"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <Tab tab_name="Theta" containers="1">
   <Container>
    <DockSplitter orientation="-" count="1" sizes="1">
     <DockArea name="Theta: real x bruto x estimado x desejado">
      <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
       <range bottom="-3.2" top="3.2" left="0" right="1"/>
       <limitY/>
       <curve name="/pose2d_real/theta" color="#2ca02c"/>
       <curve name="/pose2d_sensores/theta" color="#d62728"/>
       <curve name="/odometry/filtered/pose/pose/orientation/yaw" color="#1f77b4"/>
       <curve name="/trajetoria_desejada/pose/orientation/yaw" color="#000000"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <currentTabIndex index="0"/>
 </tabbed_widget>
 <use_relative_time_offset enabled="1"/>
 <Plugins>
  <plugin ID="DataLoad CSV"/>
  <plugin ID="DataLoad ROS2 bags"/>
  <plugin ID="ROS2 Topic Subscriber"/>
 </Plugins>
 <previouslyLoaded_Streamer name="ROS2 Topic Subscriber"/>
 <customMathEquations/>
 <snippets/>
</root>
